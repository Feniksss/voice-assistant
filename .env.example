PORT=3000

# Каким движком отвечать по умолчанию: openai или yandex.
# Если не задано — берётся первый настроенный.
DEFAULT_PROVIDER=openai

# ─────────────── OpenAI Realtime (WebRTC) ───────────────
# Оставьте пустым, чтобы выключить движок OpenAI.
OPENAI_API_KEY=sk-ваш-ключ-сюда
# Необязательно — есть значения по умолчанию.
REALTIME_MODEL=gpt-realtime-2
REALTIME_TRANSCRIBE_MODEL=gpt-realtime-whisper
REALTIME_VOICE=marin
REALTIME_EAGERNESS=low
REALTIME_SPEED=0.95
REALTIME_MAX_OUTPUT_TOKENS=400

# ─────────────── Yandex Realtime (WebSocket + LPCM) ───────────────
# Нативный русский без акцента. Движок включается, когда заданы ключ и каталог.
# API-ключ AI Studio со scope yc.ai.foundationModels.execute.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Необязательно — есть значения по умолчанию.
YANDEX_REALTIME_URL=wss://ai.api.cloud.yandex.net/v1/realtime
YANDEX_REALTIME_MODEL=speech-realtime-250923
YANDEX_VOICE=marina
# Амплуа (эмоциональная подача) зависит от голоса и выбирается на странице —
# показываются только валидные для выбранного голоса роли (см. карту в server.js).
# Темп речи синтеза. 1.0 — обычный; 0.95 звучит спокойнее.
YANDEX_SPEED=1.35
# Смещение тембра, Гц [-1000..1000]: выше — звонче/живее, ниже — глубже. 0 — как есть.
YANDEX_PITCH_SHIFT=0
# Сколько миллисекунд тишины ждать, прежде чем счесть, что человек договорил.
# Больше — терпеливее, не обрывает паузы в речи (по умолчанию 800).
YANDEX_VAD_SILENCE_MS=800
# Порог чувствительности к речи (0..1). Ниже — чутче к тихой речи.
YANDEX_VAD_THRESHOLD=0.5
# Частоты PCM (вход = выход). 44100 — как в примере Яндекса.
YANDEX_IN_RATE=44100
YANDEX_OUT_RATE=44100

# ─────────────── ElevenLabs Agents (WebSocket, signed URL) ───────────────
# Самая выразительная подача. Движок включается, когда заданы ключ и agent_id.
# Ключ: elevenlabs.io → Profile → API Keys. Агент создаётся в Agents (включите
# оверрайды prompt/language/voice в Security), его id — сюда.
ELEVEN_API_KEY=
ELEVEN_AGENT_ID=
# Необязательно — есть значения по умолчанию.
ELEVEN_TTS_MODEL=eleven_turbo_v2_5
ELEVEN_LANGUAGE=ru
ELEVEN_LLM=gpt-4o
# Голос по умолчанию (voice_id); на странице можно выбрать другой из аккаунта.
ELEVEN_VOICE=
