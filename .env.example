OPENAI_API_KEY=sk-ваш-ключ-сюда
PORT=3000

# Всё ниже — необязательно, есть значения по умолчанию.
# Модель. По умолчанию флагман; дешевле: gpt-realtime-2-mini
REALTIME_MODEL=gpt-realtime-2
REALTIME_TRANSCRIBE_MODEL=gpt-realtime-whisper

# Голос по умолчанию (на странице можно выбрать другой).
REALTIME_VOICE=marin

# Насколько «человеческой» будет речь:
# EAGERNESS — как быстро ассистент решает, что вы договорили:
#   low — ждёт дольше и не перебивает; high — отвечает мгновенно.
REALTIME_EAGERNESS=low
# SPEED — темп речи (0.25–1.5). Чуть медленнее звучит спокойнее.
REALTIME_SPEED=0.95
# MAX_OUTPUT_TOKENS — потолок длины ответа. Короче — разговорнее.
REALTIME_MAX_OUTPUT_TOKENS=400
